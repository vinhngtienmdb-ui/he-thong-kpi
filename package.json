{
  "name": "kpi-crm-system",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý Công việc & Chấm điểm KPI theo 6 trục trọng tâm và biểu mẫu CBQL",
  "main": "backend/server.js",
  "scripts": {
    "postinstall": "npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/server.js",
    "backend": "node backend/server.js",
    "frontend": "npm --prefix frontend run dev",
    "db:status": "npm --prefix backend run db:status",
    "db:push-supabase": "npm --prefix backend run db:push-supabase",
    "db:pull-supabase": "npm --prefix backend run db:pull-supabase"
  },
  "keywords": ["kpi", "quan-ly-cong-viec", "cbql"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  }
}
