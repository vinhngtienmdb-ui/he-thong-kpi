# ==============================================================================
# HỆ THỐNG KPI & QUẢN LÝ VĂN BẢN - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIG)
# ==============================================================================

# 1. CỔNG CHẠY SERVER
PORT=5000
NODE_ENV=production

# 2. SUPABASE (POSTGRESQL CLOUD DATABASE)
# Lấy chuỗi kết nối URI từ: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Có thể dùng cổng 5432 (Session mode) hoặc 6543 (Transaction pooler mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. CLOUDFLARE R2 (OBJECT STORAGE)
# Lấy từ Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=kpi-storage

# Đường dẫn Public URL (Tuỳ chọn: R2.dev subdomain hoặc Custom Domain)
# Ví dụ: https://pub-xxxxxxxx.r2.dev hoặc https://cdn.yourdomain.com
# Nếu để trống, server sẽ tự động dùng proxy: /api/storage/:key
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
